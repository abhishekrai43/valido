# Valido Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# OpenAI API Key (for AI rule generation)
OPENAI_API_KEY=your_openai_api_key_here

# License Server URL (when implemented)
LICENSE_SERVER_URL=https://license.valido.app

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
MAX_PAGES_PER_PDF=10

# Database (default uses local SQLite)
# DATABASE_URL=sqlite:///backend/data/valido.db
